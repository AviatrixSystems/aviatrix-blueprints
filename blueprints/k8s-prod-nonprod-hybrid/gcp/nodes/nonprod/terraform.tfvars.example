# -----------------------------------------------------------------------------
# Pattern C: Prod/Non-Prod Hybrid — GCP Non-Production Nodes Layer
# Copy this file to terraform.tfvars and fill in values marked as REQUIRED.
#
# This layer requires values from the gcp/clusters/nonprod/ outputs. If you
# deploy with the standard sequence these values come from remote state;
# this file documents what they represent if you need to override them.
# -----------------------------------------------------------------------------

# REQUIRED: GCP project ID — must match gcp/network/
gcp_project_id = "your-gcp-project-id"

# GCP region — must match gcp/network/
gcp_region = "us-central1"

# Must match the environment_prefix used in gcp/network/
environment_prefix = "pc-gcp"

# REQUIRED: Aviatrix Controller credentials — set as environment variables:
#   export AVIATRIX_CONTROLLER_IP="your-controller.example.com"
#   export AVIATRIX_USERNAME="admin"
#   export AVIATRIX_PASSWORD="your-password"

# REQUIRED: Sourced from gcp/clusters/nonprod/ outputs
# cluster_name           = "pc-gcp-nonprod-cluster"
# cluster_endpoint       = "34.0.0.2"
# cluster_ca_certificate = "<base64-ca-cert>"
# cluster_id             = "your-aviatrix-cluster-id"

# DNS — sourced from gcp/network/ outputs
# dns_zone_name = "internal-example-com"
# dns_domain    = "internal.example.com"

# Node pool sizing
# node_machine_type  = "e2-standard-2"
# node_min_count     = 1
# node_max_count     = 8
# initial_node_count = 2
