# -----------------------------------------------------------------------------
# Pattern C: Prod/Non-Prod Hybrid — Azure Network Layer
# Copy this file to terraform.tfvars and fill in values marked as REQUIRED.
# -----------------------------------------------------------------------------

# REQUIRED: Aviatrix Controller credentials — set as environment variables:
#   export AVIATRIX_CONTROLLER_IP="your-controller.example.com"
#   export AVIATRIX_USERNAME="admin"
#   export AVIATRIX_PASSWORD="your-password"

# REQUIRED: Aviatrix Azure account name (as registered in Controller)
azure_account_name = "your-azure-account-name"

# REQUIRED: Azure Subscription ID
azure_subscription_id = "00000000-0000-0000-0000-000000000000"

# REQUIRED: Azure Resource Group name (must exist before deploying)
resource_group_name = "rg-patternc"

# Azure region
azure_region = "East US"

# Resource name prefix
environment_prefix = "pc-azure"

# Random suffix avoids name collisions on a shared controller (recommended: true)
random_suffix = true

# HA (recommended for production deployments)
enable_ha = true

# CIDRs — defaults shown, uncomment and change only if they conflict
# transit_cidr      = "10.28.0.0/20"
# prod_vnet_cidr    = "10.30.0.0/20"
# nonprod_vnet_cidr = "10.31.0.0/20"
# db_spoke_cidr     = "10.35.0.0/22"
# pod_cidr          = "100.64.0.0/16"

# Gateway sizes
# transit_gw_size  = "Standard_D3_v2"
# spoke_gw_size    = "Standard_D3_v2"
# db_spoke_gw_size = "Standard_B2ms"

# DNS
dns_domain = "internal.example.com"

# Teams — customize namespace names for your organization
teams = {
  team-a = {
    prod_namespace    = "team-a-prod"
    nonprod_namespace = "team-a-dev"
    contact           = "team-a@example.com"
  }
  team-b = {
    prod_namespace    = "team-b-prod"
    nonprod_namespace = "team-b-staging"
    contact           = "team-b@example.com"
  }
}

# Cluster IDs — leave empty on first apply; set after clusters/prod and clusters/nonprod deploy
# prod_cluster_id    = ""
# nonprod_cluster_id = ""

# manage_dcf: set true only if DCF is NOT already enabled on this controller
# manage_dcf = false
