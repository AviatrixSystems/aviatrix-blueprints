# -----------------------------------------------------------------------------
# Pattern C: Prod/Non-Prod Hybrid — AWS Non-Production Nodes Layer
# All infrastructure values are sourced automatically from remote state.
# This layer has no required input variables.
#
# Controller credentials are read from environment variables by default:
#   export AVIATRIX_CONTROLLER_IP="your-controller.example.com"
#   export AVIATRIX_USERNAME="admin"
#   export AVIATRIX_PASSWORD="your-password"
# -----------------------------------------------------------------------------

# aws_region = "us-east-1"  # default: us-east-2

# No required variables — all values flow from aws/network/ and aws/clusters/nonprod/ state.
