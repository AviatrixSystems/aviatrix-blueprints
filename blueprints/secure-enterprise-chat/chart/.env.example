# .env.example — secret environment for LibreChat.
#
# Copy to .env, fill in real values, then create the Kubernetes Secret the chart
# expects (chart sets librechat.existingSecretName: librechat-credentials-env):
#
#   kubectl -n librechat create secret generic librechat-credentials-env \
#     --from-env-file=.env
#
# DO NOT commit a real .env. The egress-policy generator never reads secret
# VALUES — in CI it takes only the KEY NAMES via --env-keys (see ../README.md).

# --- Required: LibreChat core secrets (generate strong random values) ---
# e.g. openssl rand -hex 32  (KEY) ; openssl rand -hex 16 (IV)
CREDS_KEY=replace-with-32-byte-hex
CREDS_IV=replace-with-16-byte-hex
JWT_SECRET=replace-with-random
JWT_REFRESH_SECRET=replace-with-random

# --- Required: MeiliSearch master key (referenced by the chart) ---
MEILI_MASTER_KEY=replace-with-random

# --- Login / registration ---
# LibreChat treats these as DISABLED when unset, and the chart does not set them,
# so without these the Sign Up button never appears. They must live in THIS secret
# (the chart's envFrom secretRef) — the chart's configEnv only templates a fixed
# key set and ignores arbitrary keys. Set to false once your first admin exists.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# --- AWS Bedrock ---
# Region is ALWAYS required (LibreChat reads it from here; it is not auto-derived):
BEDROCK_AWS_DEFAULT_REGION=us-east-1
#
# Auth - pick ONE:
#  (a) EKS IRSA / Pod Identity (recommended): leave the two keys below UNSET and
#      annotate the ServiceAccount with the IAM role ARN (chart values.yaml +
#      README). LibreChat passes no explicit creds, so the AWS default provider
#      chain resolves the IRSA web-identity token. Do NOT set them to placeholders.
#  (b) Static keys (e.g. non-AWS clusters like AKS): uncomment and fill in.
# BEDROCK_AWS_ACCESS_KEY_ID=your_access_key_id
# BEDROCK_AWS_SECRET_ACCESS_KEY=your_secret_access_key

# --- Azure OpenAI (Azure path; see endpoints.custom in librechat.yaml) ---
# AZURE_API_KEY=your_azure_openai_key

# --- Optional integrations (each, when set + matched in librechat.yaml/catalog,
#     widens the egress allowlist) ---
# RAG_OPENAI_API_KEY=your_openai_key       # -> api.openai.com
# TAVILY_API_KEY=your_tavily_key           # -> api.tavily.com
# WOLFRAM_APP_ID=your_wolfram_app_id       # -> www.wolframalpha.com
# OPENWEATHER_API_KEY=your_owm_key         # -> api.openweathermap.org
